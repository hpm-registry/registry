      "voltage": {
        "min": 2.0,
        "max": 3.6,
        "unit": "V"
      },
      "decoupling": "100nF ceramic per VDD pin + one 4.7uF bulk capacitor on VDD_3"
    },
    {
      "name": "VDDA",
      "pins": [
        "VDDA"
      ],
      "voltage": {
        "min": 2.0,
        "max": 3.6,
        "unit": "V",
        "notes": "min 2.4V when ADC used"
      },
      "decoupling": "1uF + 10nF ceramic close to VDDA pin; ferrite bead to VDD recommended"
    },
    {
      "name": "VBAT",
      "pins": [
        "VBAT"
      ],
      "voltage": {
        "min": 1.8,
        "max": 3.6,
        "unit": "V"
      },
      "decoupling": "Connect to VDD if backup not used, otherwise to battery with 100nF decoupling"
    }
  ],
  "required_externals": [
    {
      "value": "100nF",
      "description": "Decoupling capacitor for each VDD pin",
      "connects": [
        "VDD",
