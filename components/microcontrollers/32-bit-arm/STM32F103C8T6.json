        "GND"
      ]
    },
    {
      "value": "100nF",
      "description": "NRST reset filter capacitor",
      "connects": [
        "NRST",
        "GND"
      ]
    },
    {
      "description": "HSE crystal (4-16 MHz, typically 8 MHz) for USB operation",
      "connects": [
        "OSC_IN",
        "OSC_OUT"
      ],
      "notes": "Required for USB; load caps per crystal spec (typ 18-20pF)"
    },
    {
      "value": "1.5k",
      "description": "USB pull-up on D+ to indicate full-speed device (if USB used)",
      "connects": [
        "PA12",
        "VDD"
      ],
      "notes": "Required to be compliant with USB 2.0 full-speed electrical specification"
    }
