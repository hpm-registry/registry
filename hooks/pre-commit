#!/bin/sh
# Block commits where component files changed but index is stale.

# Only check if components/, footprints/, symbols/, or 3d_models/ are being committed
if ! git diff --cached --name-only | grep -qE '^(components|footprints|symbols|3d_models)/'; then
  exit 0
fi

python system_scripts/build_index.py --quiet 2>/dev/null

if [ -n "$(git status --porcelain index/)" ]; then
  echo ""
  echo "ERROR: index/ is stale after your component changes."
  echo "  Run: python system_scripts/build_index.py"
  echo "  Then: git add index/ && git commit"
  echo ""
  exit 1
fi

exit 0
